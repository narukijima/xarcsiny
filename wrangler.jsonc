{
  "name": "xarcsiny",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "xarcsiny.com", "custom_domain": true },
    { "pattern": "www.xarcsiny.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
